{
	"name": "nutric",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"scrape": "tsx scripts/scrape.ts",
		"seed": "tsx --env-file=.env scripts/seed.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"@types/sanitize-html": "^2.16.2",
		"@types/three": "^0.186.0",
		"drizzle-kit": "^0.31.11",
		"playwright": "^1.64.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/fraunces": "^5.3.0",
		"@fontsource/noto-sans-sc": "^5.3.1",
		"@fontsource/noto-sans-tc": "^5.3.1",
		"@fontsource/noto-sans-thai": "^5.3.0",
		"@fontsource/noto-serif-sc": "^5.3.1",
		"@fontsource/noto-serif-tc": "^5.3.1",
		"@fontsource/noto-serif-thai": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"marked": "^18.1.0",
		"sanitize-html": "^2.18.0",
		"three": "^0.186.1",
		"zod": "^4.6.5"
	}
}
